<Window
    x:Class="MyMemories.DataExtractorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PDF Data Extractor">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel 
            Grid.Row="0" 
            Orientation="Horizontal" 
            Padding="12" 
            Spacing="8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            
            <Button 
                x:Name="ExtractButton"
                Content="📊 Extract Tables"
                Click="ExtractButton_Click"
                Style="{StaticResource AccentButtonStyle}"/>
            
            <Button 
                x:Name="ExportButton"
                Content="💾 Export to CSV"
                Click="ExportButton_Click"
                IsEnabled="False"/>
            
            <Button 
                x:Name="CopyButton"
                Content="📋 Copy to Clipboard"
                Click="CopyButton_Click"
                IsEnabled="False"/>
            
            <!-- Table Navigation -->
            <Border 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Padding="8,0,0,0"
                Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button 
                        x:Name="PreviousTableButton"
                        Content="◀ Previous"
                        Click="PreviousTableButton_Click"
                        IsEnabled="False"
                        MinWidth="80"/>
                    
                    <Button 
                        x:Name="NextTableButton"
                        Content="Next ▶"
                        Click="NextTableButton_Click"
                        IsEnabled="False"
                        MinWidth="80"/>
                </StackPanel>
            </Border>
            
            <TextBlock 
                x:Name="StatusText"
                VerticalAlignment="Center"
                Margin="16,0,0,0"
                Text="Ready to extract tables..."
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- PDF Viewer -->
                <ColumnDefinition Width="Auto"/>
                <!-- Splitter -->
                <ColumnDefinition Width="*"/>
                <!-- Data Grid -->
            </Grid.ColumnDefinitions>

            <!-- PDF Viewer -->
            <Border 
                Grid.Column="0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                
                <Grid>
                    <WebView2 
                        x:Name="PdfViewer"
                        Margin="4"/>
                    
                    <ProgressRing 
                        x:Name="PdfLoadingRing"
                        Width="40"
                        Height="40"
                        IsActive="True"
                        Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Splitter -->
            <Border 
                Grid.Column="1"
                Width="5"
                Background="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </Border>

            <!-- Data Grid Area -->
            <Grid Grid.Column="2">
                <ScrollViewer 
                    x:Name="DataScrollViewer"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Padding="8">
                    
                    <Grid x:Name="DataGridContainer">
                        <!-- DataGrid will be populated programmatically -->
                        <TextBlock 
                            x:Name="EmptyStateText"
                            Text="Click 'Extract Tables' to analyze the PDF document"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="14"/>
                    </Grid>
                </ScrollViewer>

                <ProgressRing 
                    x:Name="ExtractionProgressRing"
                    Width="60"
                    Height="60"
                    IsActive="False"
                    Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
